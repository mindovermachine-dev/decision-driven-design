# Deployment frequency (DORA): successful o13 occurrences in the window, per week. One row per
# deployment; the reading is count / (window length in weeks). [PROPOSED] (sdlc.md §18).
PREFIX lc: <https://decision-driven-design.dk/ns/lifecycle#>
PREFIX m:  <https://decision-driven-design.dk/ns/lifecycle/map#>
SELECT ?d ?at WHERE {
  ?d lc:atAct m:o13 ; lc:verdict lc:Passed ; lc:startedAt ?at .
}
