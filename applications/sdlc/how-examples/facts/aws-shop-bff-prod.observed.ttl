# What the AWS reporter, edition aws/1, would read from the RUNNING unit (the account's resource
# inventory) at the time in facts/manifest.json. Hand-written. Agrees with the declaration.
@prefix sdlc: <https://decision-driven-design.dk/ns/sdlc#> .
@prefix u: <https://acme.example/units/shop-bff-prod#> .
@prefix region: <https://decision-driven-design.dk/ns/sdlc/region/aws#> .

u:sessions-db a sdlc:DataStore ; sdlc:holdsPersonalData true ; sdlc:inRegion region:eu-central-1 .
u:exports-bucket a sdlc:DataStore ; sdlc:holdsPersonalData true ; sdlc:inRegion region:us-east-1 .
