@prefix lc:  <https://decision-driven-design.dk/ns/lifecycle#> .
@prefix ex:  <https://example.org/acme-shop/pdlc#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

#################################################################
#  An illustrative option pool and one delivery, for the acme shop: invented data, not a ruling
#  (the vocabulary and shapes it exercises are ruled, Round 28, R30).
#  Invented to exercise the shapes; it records nothing that happened. pdlc.md §10 computes the
#  pool's metrics over it as a worked example.
#################################################################

ex:opt1 a lc:Option ;
  lc:contributor lc:WhenOwner ;
  lc:need "A returning customer cannot reorder a past order in one step; it matters before the spring campaign." ;
  lc:mattersBy "2027-03-01"^^xsd:date ;
  lc:proposedAt "2026-11-02"^^xsd:date ;
  lc:exit [ a lc:Pulled ; lc:decidedBy lc:WhenOwner ; lc:decidedAt "2026-11-05"^^xsd:date ; lc:issue 101 ; lc:rank 1 ] .

ex:opt2 a lc:Option ;
  lc:contributor lc:WhatOwner ;
  lc:need "Support staff cannot tell a cancelled order from a refunded one (user feedback)." ;
  lc:mattersBy "2027-01-31"^^xsd:date ;
  lc:proposedAt "2026-10-20"^^xsd:date ;
  lc:exit [ a lc:Pulled ; lc:decidedBy lc:WhenOwner ; lc:decidedAt "2026-11-05"^^xsd:date ; lc:issue 102 ; lc:rank 2 ] .

ex:opt3 a lc:Option ;
  lc:contributor lc:WhenOwner ;
  lc:need "Wholesale buyers cannot pay by invoice; it matters for the trade fair." ;
  lc:mattersBy "2026-10-15"^^xsd:date ;
  lc:proposedAt "2026-09-01"^^xsd:date ;
  lc:exit [ a lc:Expired ; lc:decidedBy lc:WhenOwner ; lc:decidedAt "2026-10-16"^^xsd:date ] .

# The How owner's "manual cache purge" was an option here until Round 26: under Round 22 it is
# own-ground work and never enters the pool. It is now issue #104 at the own-ground entry (oG), in
# applications/sdlc/acts/example-record.ttl.

ex:opt5 a lc:Option ;
  lc:contributor lc:WhenOwner ;
  lc:need "A customer cannot save a basket across devices." ;
  lc:mattersBy "2027-09-01"^^xsd:date ;
  lc:proposedAt "2026-11-04"^^xsd:date .

# Issue 101 landed dark behind ex:reorder; the What owner found it ready; the When owner turned it on.
ex:reorder a lc:Toggle .

ex:ready101 a lc:ReadyForUsers ;
  lc:decidedBy lc:WhatOwner ;
  lc:toggle ex:reorder ;
  lc:ready true ;
  lc:userSideShare "a help-centre article on reordering, published" ;
  lc:checksObservation [ lc:observationNeed "https://example.org/acme-shop/what/observation-need-reorder-in-use" ; lc:telemetryPresent true ] .

ex:on101 a lc:ToggleOn ;
  lc:decidedBy lc:WhenOwner ;
  lc:toggle ex:reorder ;
  lc:readsVerdict ex:ready101 ;
  prov:startedAtTime "2026-11-08T08:00:00Z"^^xsd:dateTime .


# A reported defect, classified by the What owner as owed: it entered the SDLC as issue #103 without
# o2a (Round 22).
ex:class103 a lc:Classification ;
  lc:decidedBy lc:WhatOwner ;
  lc:report "Reorder adds the out-of-stock line to the basket, against the Place order Decider's stock invariant." ;
  lc:classifiedAs lc:OwedDemand ;
  lc:decidedAt "2026-11-06"^^xsd:date .
