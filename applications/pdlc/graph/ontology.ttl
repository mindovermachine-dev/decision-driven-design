@prefix lc:   <https://decision-driven-design.dk/ns/lifecycle#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

#################################################################
#  lc: — the lifecycle vocabulary of the PDLC and the SDLC. ruled by Round 28 (R30).
#
#  The act map's form (method step 1; DDD-ground-06, DDD-address-01) for the product lifecycle:
#  composite acts, act sites with addresses on declared axes, causal dependencies, an occupant
#  lens kept out of the address, the option pool, the ready-for-users verdict and toggles, and
#  the occurrence record (DDD-dec-114, DDD-dec-115).
#
#  This is NOT the sdlc: namespace. sdlc: edition 1 is read-forever from its tag (DDD-dec-113,
#  E-6) and nothing here adds to it. lc: carries no version IRI until it is ruled.
#  Every term carries its dct:source.
#################################################################

<https://decision-driven-design.dk/ns/lifecycle>
  a owl:Ontology ;
  rdfs:label "lc: — the lifecycle vocabulary (PDLC and SDLC), ruled, Round 28" ;
  dct:source "applications/pdlc/pdlc.md; applications/sdlc/sdlc.md; DDD-dec-114; DDD-dec-115" .

#########################  ACTS AND ADDRESSES  #########################

lc:CompositeAct a owl:Class ;
  rdfs:comment "An act that other acts sit within. Its members' layer paths pass through it (DDD-ground-06)." ;
  dct:source "DDD-ground-06; DDD-dec-114 (the SDLC within the PDLC)" .

lc:Act a owl:Class ;
  rdfs:comment "An act site of the map: one address, possibly many occurrences told apart by the time index (DDD-address-01). Named oN as in the act map." ;
  dct:source "method/01-map-and-index-acts.md; DDD-address-01" .

lc:within a owl:ObjectProperty ;
  rdfs:comment "The composite act an act or composite act sits within, one step of its layer path." ;
  dct:source "DDD-ground-06" .

lc:layerPath a owl:DatatypeProperty ;
  rdfs:comment "The layer path written out, outermost first, joined by ' ▸ '. It must agree with lc:within*." ;
  dct:source "DDD-ground-06; DDD-dec-114 P-1" .

lc:address a owl:ObjectProperty ;
  rdfs:comment "The act's address: its position on the declared axes. The layer path is the other half and is held on the act. The occupant is never part of it." ;
  dct:source "DDD-ground-06" .

lc:Address a owl:Class ;
  rdfs:comment "A position on the declared axes." ;
  dct:source "DDD-ground-06" .

lc:surfaceRead a owl:ObjectProperty ;
  rdfs:comment "Axis 1: the surface the act reads its ground from." ;
  dct:source "rulings.md, the act map (axes accepted for now, Round 2)" .

lc:changeLocus a owl:ObjectProperty ;
  rdfs:comment "Axis 2: the DDD-frame-01 coordinate the change moves, as declared on the issue." ;
  dct:source "DDD-dec-114 P-8; Round 4" .

lc:authorityRead a owl:ObjectProperty ;
  rdfs:comment "Axis 3: the authority the act reads." ;
  dct:source "rulings.md, the act map" .

lc:Surface a owl:Class ; rdfs:comment "A value of the surface-read axis." ; dct:source "rulings.md, the act map" .
lc:Locus a owl:Class ; rdfs:comment "A value of the change-locus axis: a DDD-frame-01 coordinate." ; dct:source "DDD-dec-114 P-8" .
lc:Authority a owl:Class ; rdfs:comment "A value of the authority-read axis." ; dct:source "rulings.md, the act map" .

lc:OptionPool a lc:Surface ; rdfs:label "option pool" ; dct:source "DDD-dec-114 P-5 (PDLC surface; ruled, Round 28, R17)" .
lc:IssueThread a lc:Surface ; rdfs:label "issue thread" ; dct:source "rulings.md, the act map" .
lc:SessionBranch a lc:Surface ; rdfs:label "session branch" ; dct:source "rulings.md, the act map" .
lc:Candidate a lc:Surface ; rdfs:label "candidate (ready/<N>)" ; dct:source "rulings.md, the act map" .
lc:Trunk a lc:Surface ; rdfs:label "trunk" ; dct:source "rulings.md, the act map" .
lc:Production a lc:Surface ; rdfs:label "production" ; dct:source "rulings.md, the act map" .
lc:UseSite a lc:Surface ; rdfs:label "the product in use" ; dct:source "DDD-dec-114 P-1 (the acts of using the product; ruled, Round 28, R17)" .

lc:What a lc:Locus ; rdfs:label "what (acceptance relation, tolerance)" ; dct:source "Round 4" .
lc:How a lc:Locus ; rdfs:label "how (arrangement)" ; dct:source "Round 4" .
lc:Ground a lc:Locus ; rdfs:label "ground" ; dct:source "Round 4" .
lc:Assurance a lc:Locus ;
  rdfs:label "assurance (product assurance)" ;
  rdfs:comment "An assurance-locus issue changes product assurance: how sure we can be that users do the act we designed. A change to implementation assurance is How-locus (Round 19)." ;
  dct:source "Round 4; Round 19" .
lc:DeclaredLocus a lc:Locus ;
  rdfs:label "the issue's declared locus" ;
  rdfs:comment "In the map only: the act's position on this axis is the locus its issue declares. A record carries the concrete value." ;
  dct:source "Round 3 (declared on the issue)" .
lc:NoLocus a lc:Locus ;
  rdfs:label "no coordinate (before framing)" ;
  rdfs:comment "o0 and o2a: an option moves no coordinate, and ordering moves none (DDD-dec-114 P-8)." ;
  dct:source "DDD-dec-114 P-5, P-8" .

lc:NoAuthority a lc:Authority ; rdfs:label "none" ; dct:source "rulings.md, the act map" .
lc:BaseIdentityMap a lc:Authority ; rdfs:label "base identity map" ; dct:source "rulings.md, the act map" .
lc:ApprovalAtHead a lc:Authority ; rdfs:label "approval at head" ; dct:source "rulings.md, the act map" .
lc:OwnerScope a lc:Authority ;
  rdfs:label "an owner's scope grant" ;
  rdfs:comment "PDLC acts read the grant of the owner scope they are made under (authority.md §3). Added for the PDLC's acts; ruled, Round 28, R17." ;
  dct:source "DDD-dec-114 P-1" .

lc:dependsOn a owl:ObjectProperty ;
  rdfs:comment "B lc:dependsOn A iff a state change A produces is in B's ground reading. The time index is the order this induces, not wall-clock." ;
  dct:source "DDD-address-01" .

lc:because a owl:DatatypeProperty ;
  rdfs:comment "The state change of the depended-on act that is in this act's ground reading." ;
  dct:source "method/quick-start.md (the act map's form)" .

lc:Dependency a owl:Class ; rdfs:comment "A reified lc:dependsOn, carrying lc:on and lc:because." ; dct:source "method/quick-start.md" .
lc:dependency a owl:ObjectProperty ; rdfs:comment "An act's reified dependency." ; dct:source "method/quick-start.md" .
lc:on a owl:ObjectProperty ; rdfs:comment "The act a dependency is on." ; dct:source "method/quick-start.md" .

lc:readsEarlier a owl:ObjectProperty ;
  rdfs:comment "Ground this act reads that earlier occurrences of other issues produced at the named act (o2a reads the cadence from earlier o13s; o11 reads the base identity map). Kept apart from lc:dependency so the within-issue causal order between act sites stays acyclic." ;
  dct:source "DDD-address-01; rulings.md, the act map (o11's reading)" .

lc:heldBy a owl:ObjectProperty ;
  rdfs:comment "The owner scope that holds the act, with control and liability (the placement rule). Not the occupant." ;
  dct:source "DDD-dec-114 P-2" .

lc:occupantLens a owl:DatatypeProperty ;
  rdfs:comment "Who occupies the act, as a lens beside the address and never inside it: human, model, program, or a choice among them." ;
  dct:source "DDD-ground-06 (the occupying actor is not a component of the address)" .

lc:recurs a owl:DatatypeProperty ; rdfs:comment "How often the act recurs, e.g. per issue, per comment." ; dct:source "rulings.md, the act map" .
lc:label a owl:DatatypeProperty ; rdfs:comment "What the act does, in a few words." ; dct:source "rulings.md, the act map" .

#########################  OWNERS  #########################

lc:OwnerRole a owl:Class ; rdfs:comment "An owner scope under the genesis grant (authority.md §2–3)." ; dct:source "DDD-dec-114 P-1" .
lc:WhatOwner a lc:OwnerRole ; rdfs:label "What owner" ; dct:source "DDD-dec-114 P-1" .
lc:WhenOwner a lc:OwnerRole ; rdfs:label "When owner (the business; go-to-market)" ; dct:source "DDD-dec-114 P-1; Rounds 10, 11" .
lc:HowOwner a lc:OwnerRole ; rdfs:label "How owner" ; dct:source "DDD-dec-114 P-1" .
lc:LocusOwner a lc:OwnerRole ;
  rdfs:label "the owner of the issue's declared locus" ;
  rdfs:comment "o1 and o10: held by the owner of the locus the issue declares (What owner for What and assurance, How owner for How, the ground's owner for ground). Not a scope of its own. Ruled, Round 28, R16." ;
  dct:source "DDD-dec-114 P-2, P-3; DDD-dec-115 S-5" .
lc:AnyOwner a lc:OwnerRole ;
  rdfs:label "any owner" ;
  rdfs:comment "o0 only: any owner may propose an option. Not a scope." ;
  dct:source "DDD-dec-114 P-5" .

#########################  THE OPTION POOL  #########################

lc:Option a owl:Class ;
  rdfs:comment "A proposed change before ordering: an outcome or need, never a What change." ;
  dct:source "DDD-dec-114 P-5" .
lc:contributor a owl:ObjectProperty ; rdfs:comment "The owner scope that proposed the option (o0)." ; dct:source "DDD-dec-114 P-5" .
lc:need a owl:DatatypeProperty ; rdfs:comment "The outcome or need: who cannot do what." ; dct:source "DDD-dec-114 P-5" .
lc:mattersBy a owl:DatatypeProperty ; rdfs:comment "The end of the market window: by when the need matters." ; dct:source "DDD-dec-114 P-5" .
lc:proposedAt a owl:DatatypeProperty ; rdfs:comment "When the option entered the pool (wall-clock, for option age)." ; dct:source "pdlc.md §8" .
lc:changesWhatElement a owl:ObjectProperty ;
  rdfs:comment "Forbidden on an option: an option never names a What element it changes. Present only so the shape can refuse it." ;
  dct:source "DDD-dec-114 P-5" .
lc:exit a owl:ObjectProperty ; rdfs:comment "The recorded When-owner decision by which the option left the pool." ; dct:source "DDD-dec-114 P-5" .
lc:Exit a owl:Class ; rdfs:comment "An option's exit decision." ; dct:source "DDD-dec-114 P-5" .
lc:Pulled a owl:Class ; rdfs:subClassOf lc:Exit ; rdfs:comment "Released for work at o2a." ; dct:source "DDD-dec-114 P-5" .
lc:Declined a owl:Class ; rdfs:subClassOf lc:Exit ; rdfs:comment "Declined, with a reason." ; dct:source "DDD-dec-114 P-5" .
lc:Expired a owl:Class ; rdfs:subClassOf lc:Exit ; rdfs:comment "Expired when its market window passed." ; dct:source "DDD-dec-114 P-5" .
lc:decidedBy a owl:ObjectProperty ; rdfs:comment "The owner scope a decision was made under." ; dct:source "DDD-dec-114 P-2" .
lc:decidedAt a owl:DatatypeProperty ; rdfs:comment "When the decision was made (wall-clock)." ; dct:source "pdlc.md §8" .
lc:reason a owl:DatatypeProperty ; rdfs:comment "Why an option was declined." ; dct:source "DDD-dec-114 P-5" .
lc:issue a owl:DatatypeProperty ; rdfs:comment "The issue number a pulled option became, or an occurrence belongs to." ; dct:source "DDD-dec-114 P-5; DDD-dec-115 S-4" .
lc:rank a owl:DatatypeProperty ; rdfs:comment "The pulled option's position in the When owner's order at o2a." ; dct:source "DDD-dec-114 P-8 (chosen order)" .

#########################  READY FOR USERS AND TOGGLES  #########################

lc:Toggle a owl:Class ; rdfs:comment "A release toggle: created and retired by the How owner, turned on by the When owner." ; dct:source "DDD-dec-114 P-4; DDD-dec-115 S-3" .
lc:ReadyForUsers a owl:Class ;
  rdfs:comment "The What owner's verdict that product acceptance is met, by the software's share and the user-side share, for a toggle's change. The record holds the declaration and ground reading; the verdict is computed (DDD-dec-52)." ;
  dct:source "DDD-dec-114 P-4" .
lc:ToggleOn a owl:Class ;
  rdfs:subClassOf prov:Activity ;
  rdfs:comment "o16: the When owner's act of turning a toggle on, recorded by the When owner's toggle service with PROV: associated with the When owner (its lc:decidedBy, read as prov:wasAssociatedWith on a release only; lc:decidedBy is not a sub-property, since exits and classifications are not releases), using the ready-for-users verdict (lc:readsVerdict, a sub-property of prov:used), with prov:startedAtTime as the release time (Round 28, R5; PROV read as W3C PROV-O, UNVERIFIED — Emil review)." ;
  dct:source "DDD-dec-114 P-4; DDD-dec-115 S-11" .
lc:toggle a owl:ObjectProperty ; rdfs:comment "The toggle a verdict or act concerns." ; dct:source "DDD-dec-114 P-4" .
lc:ready a owl:DatatypeProperty ; rdfs:comment "Whether the ready-for-users verdict found the change ready." ; dct:source "DDD-dec-114 P-4" .
lc:readsVerdict a owl:ObjectProperty ;
  rdfs:subPropertyOf prov:used ; rdfs:comment "The ready-for-users verdict o16 read." ; dct:source "DDD-dec-114 P-4" .
lc:userSideShare a owl:DatatypeProperty ; rdfs:comment "The user-side share the verdict covers: training, guidance, procedure, or none needed." ; dct:source "DDD-dec-114 P-1; Round 7" .

#########################  THE OCCURRENCE RECORD (SDLC)  #########################

lc:Occurrence a owl:Class ;
  rdfs:comment "One occurrence of an act, as recorded by the dispatcher from edition 1." ;
  dct:source "DDD-dec-115 S-6" .
lc:atAct a owl:ObjectProperty ; rdfs:comment "The act site (oN) this occurrence is an occurrence of." ; dct:source "DDD-dec-115 S-6" .
lc:after a owl:ObjectProperty ;
  rdfs:comment "An earlier occurrence whose state change is in this occurrence's ground reading: the time index, recorded (DDD-address-01)." ;
  dct:source "DDD-address-01; DDD-dec-115 S-6" .
lc:readsHead a owl:DatatypeProperty ; rdfs:comment "The branch or candidate head SHA the occurrence read." ; dct:source "DDD-dec-52" .
lc:readsIssuePosition a owl:DatatypeProperty ; rdfs:comment "The id of the last issue comment the occurrence read (0 when it read the body alone)." ; dct:source "DDD-dec-52" .
lc:occupant a owl:DatatypeProperty ; rdfs:comment "The occupant's id in .github/identities.json, or 'program:<workflow>'. Held on the occurrence, never on its address." ; dct:source "DDD-ground-06; DDD-dec-115 S-5" .
lc:occupantKind a owl:DatatypeProperty ; rdfs:comment "human, model or program." ; dct:source "rulings.md, the act map" .
lc:tokensIn a owl:DatatypeProperty ; rdfs:comment "Model input tokens, as reported by the run. Absent when not reported; never estimated." ; dct:source "DDD-dec-115 S-6" .
lc:tokensOut a owl:DatatypeProperty ; rdfs:comment "Model output tokens, as reported by the run. Absent when not reported; never estimated." ; dct:source "DDD-dec-115 S-6" .
lc:wallSeconds a owl:DatatypeProperty ; rdfs:comment "Wall time of the occurrence in seconds." ; dct:source "DDD-dec-115 S-6" .
lc:humanWaitSeconds a owl:DatatypeProperty ; rdfs:comment "Time the occurrence's issue waited on a human before this occurrence could start." ; dct:source "DDD-dec-115 S-6" .
lc:startedAt a owl:DatatypeProperty ; rdfs:comment "Wall-clock start: for measurement only, never the time index." ; dct:source "DDD-address-01" .
lc:verdict a owl:ObjectProperty ; rdfs:comment "The occurrence's outcome." ; dct:source "DDD-dec-115 S-6" .
lc:Verdict a owl:Class ; rdfs:comment "An occurrence's outcome." ; dct:source "DDD-dec-115 S-6" .
lc:Passed a lc:Verdict ; rdfs:label "passed" ; dct:source "DDD-dec-115 S-6" .
lc:Failed a lc:Verdict ; rdfs:label "failed" ; dct:source "DDD-dec-115 S-6" .
lc:Refused a lc:Verdict ; rdfs:label "refused (by a gate or the dispatcher)" ; dct:source "DDD-dec-115 S-6" .
lc:Done a lc:Verdict ; rdfs:label "done (an act with no pass/fail, e.g. a direction)" ; dct:source "DDD-dec-115 S-6" .
lc:suppliedLocus a owl:ObjectProperty ;
  rdfs:comment "For o6 only: the locus of the decision a direction supplied (What, How, or lc:CodeOnly), for the hotspot classes." ;
  dct:source "sdlc.md §14 (hotspot o5 ↔ o6)" .
lc:CodeOnly a lc:Locus ; rdfs:label "code only (the occupant's own judgment)" ; dct:source "sdlc.md §14" .

#########################  DEMAND KINDS — Round 22  #########################

lc:DemandKind a owl:Class ;
  rdfs:comment "The kind of demand an issue carries: new, owed or own-ground (DDD-dec-114 P-13)." ;
  dct:source "DDD-dec-114 P-13; Round 22" .
lc:NewDemand a lc:DemandKind ; rdfs:label "new" ;
  rdfs:comment "A need not yet in the What. Through the option pool, ordered by the When owner." ; dct:source "Round 22" .
lc:OwedDemand a lc:DemandKind ; rdfs:label "owed" ;
  rdfs:comment "A decision in the What in force that the software does not meet. Enters the SDLC directly, ordered by the How owner." ; dct:source "Round 22" .
lc:OwnGroundDemand a lc:DemandKind ; rdfs:label "own-ground" ;
  rdfs:comment "Work on the How owner's own ground: technical debt, the arrangement, dependencies, platform. Enters the SDLC directly, ordered by the How owner." ; dct:source "Round 22" .
lc:demandKind a owl:ObjectProperty ;
  rdfs:comment "The demand kind an occurrence's issue declares." ; dct:source "DDD-dec-115 S-8" .
lc:forKind a owl:ObjectProperty ;
  rdfs:comment "On a dependency in the map: the demand kind the dependency applies to. A dependency with no lc:forKind applies to every kind." ;
  dct:source "sdlc.md §16 (ruled, Round 28, R18)" .

lc:Classification a owl:Class ;
  rdfs:comment "oC: the What owner's verdict on a reported defect, owed or new (Round 22). Read by the How and When owners." ;
  dct:source "DDD-dec-114 P-13" .
lc:classifiedAs a owl:ObjectProperty ; rdfs:comment "The kind a classification found: lc:OwedDemand or lc:NewDemand." ; dct:source "Round 22" .
lc:report a owl:DatatypeProperty ; rdfs:comment "The reported defect a classification judges, as stated." ; dct:source "Round 22" .

#########################  EVIDENCE IN USE — Rounds 16, 17  #########################

lc:checksObservation a owl:ObjectProperty ;
  rdfs:comment "On a ready-for-users verdict: one observation need it checked for telemetry presence." ;
  dct:source "DDD-dec-114 P-12; Round 17" .
lc:observationNeed a owl:DatatypeProperty ;
  rdfs:comment "The observation need checked, by its What element IRI as a string until the What schema defines the element (successor item)." ;
  dct:source "Round 17; form ruled, Round 28, R24" .
lc:telemetryPresent a owl:DatatypeProperty ;
  rdfs:comment "Whether the telemetry the observation need asks for exists in production." ;
  dct:source "Round 16; DDD-dec-114 P-12" .

#########################  DORA KEYS — Round 20  #########################

lc:restores a owl:ObjectProperty ;
  rdfs:comment "On an owed issue's o13 occurrence: the earlier o13 occurrence whose change failed and which this one restores. Feeds change failure rate and time to restore." ;
  dct:source "DDD-dec-115 S-10" .
lc:failureObservedAt a owl:DatatypeProperty ;
  rdfs:comment "On a restoring o13 occurrence: when the failure was first observed in production." ;
  dct:source "DDD-dec-115 S-10" .
lc:DoraReading a owl:Class ;
  rdfs:comment "One computed DORA key over a window, as the How owner's answerability (Round 20). Computed, never authored." ;
  dct:source "DDD-dec-115 S-10" .
lc:key a owl:ObjectProperty ; rdfs:comment "Which DORA key a reading is." ; dct:source "DDD-dec-115 S-10" .
lc:DoraKey a owl:Class ; rdfs:comment "One of DORA's four keys." ; dct:source "production-as-ground.md §2" .
lc:LeadTime a lc:DoraKey ; rdfs:label "change lead time" ; dct:source "production-as-ground.md §2" .
lc:DeployFrequency a lc:DoraKey ; rdfs:label "deployment frequency" ; dct:source "production-as-ground.md §2" .
lc:ChangeFailureRate a lc:DoraKey ; rdfs:label "change failure rate" ; dct:source "production-as-ground.md §2" .
lc:TimeToRestore a lc:DoraKey ; rdfs:label "failed-deployment recovery time" ; dct:source "production-as-ground.md §2" .
lc:windowStart a owl:DatatypeProperty ; rdfs:comment "Start of the reading's window." ; dct:source "DDD-dec-115 S-10" .
lc:windowEnd a owl:DatatypeProperty ; rdfs:comment "End of the reading's window." ; dct:source "DDD-dec-115 S-10" .
lc:value a owl:DatatypeProperty ; rdfs:comment "The reading's value, in its unit." ; dct:source "DDD-dec-115 S-10" .
lc:unit a owl:DatatypeProperty ; rdfs:comment "The value's unit: seconds, per week, or ratio." ; dct:source "DDD-dec-115 S-10" .
lc:fromOccurrences a owl:DatatypeProperty ; rdfs:comment "How many occurrences the reading was computed over." ; dct:source "DDD-dec-115 S-10" .
