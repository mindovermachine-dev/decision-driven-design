<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>canon</AssemblyName>
    <RootNamespace>Canon</RootNamespace>
    <Version>0.1.0</Version>

    <!-- A dotnet tool (DDD-dec-101). Packing is how it is built as one;
         nothing publishes it (DDD-dec-106). -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>canon</ToolCommandName>
    <PackageId>Canon</PackageId>
    <Description>Gates and repository operations for the Decision-Driven Design canon repositories.</Description>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>

    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Varve.Rdf" />
    <PackageReference Include="Varve.Turtle" />
    <PackageReference Include="Varve.JsonLd" />
    <PackageReference Include="Varve.Shacl" />
    <PackageReference Include="Varve.Shacl.Sparql" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shapes and the JSON-LD context: data, embedded so the tool
         carries them (DESIGN.md §5). Resource names are Canon.Shapes.<file>. -->
    <EmbeddedResource Include="Shapes/*.ttl;Shapes/*.jsonld" LogicalName="Canon.Shapes.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Canon.Tests" />
  </ItemGroup>

</Project>
